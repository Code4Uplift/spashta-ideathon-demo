# SPASHTA Backend Configuration
# Database Connection URL (Supabase PostgreSQL in production, SQLite locally)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres

# API Key for protected endpoints (/score and /certificate)
API_KEY=spashta-secret-key-2026

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000,https://spashta.vercel.app

# Port for local server
PORT=8000
