# =============================================================================
# SPASHTA (स्पष्ट) - Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. TCET Centre of Excellence (CoE) AI Gateway (On-Campus NVIDIA DGX Spark)
# -----------------------------------------------------------------------------
# Powered by NVIDIA DGX Spark workstation running Qwen3.6-35B-A3B (MoE, 3B active)
# Base URL defaults to campus gateway: https://ai.tcetcercd.in/v1
COE_AI_BASE_URL=https://ai.tcetcercd.in/v1

# Your personal TCET CoE AI Gateway API Key (format: sk-...)
# Obtain from your TCET faculty / CoE lab coordinator
COE_AI_KEY=your_tcet_coe_api_key_here

# -----------------------------------------------------------------------------
# 2. SPASHTA Internal API Security & CORS
# -----------------------------------------------------------------------------
# Secret key required to issue cryptographic SHA-256 compliance audit certificates
SPASHTA_API_KEY=spashta-secret-key-2026

# Additional allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://spashta-seven.vercel.app

# -----------------------------------------------------------------------------
# 3. Database (PostgreSQL / Supabase / SQLite)
# -----------------------------------------------------------------------------
# If omitted or unreachable, SPASHTA automatically defaults to local SQLite: sqlite:///./spashta.db
DATABASE_URL=postgresql://postgres.xxx:yyy@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# 4. Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
